<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MidnightVault.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="960" Padding="32" Spacing="20" HorizontalAlignment="Stretch">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="备份概览" />
            <TextBlock FontSize="16" Text="两台手机 · 每天北京时间 00:00 · 增量、只增不删" TextWrapping="Wrap" />

            <TextBlock x:Name="StatusText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="接收服务尚未配置" />
            <TextBlock Text="等待绑定外接硬盘和手机设备。" TextWrapping="Wrap" />

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="下一次任务" />
                    <TextBlock FontSize="22" Text="今天 00:00" />
                    <TextBlock Text="北京时间" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="已配对设备" />
                    <TextBlock FontSize="22" Text="0 / 2" />
                    <TextBlock Text="扫码配对后显示" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="备份盘" />
                    <TextBlock FontSize="22" Text="未选择" />
                    <TextBlock Text="按卷唯一 ID 绑定" />
                </StackPanel>
            </Grid>

            <Button HorizontalAlignment="Left" Click="BackupNow_Click" Content="立即备份" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="最近任务" />
            <TextBlock Text="尚无备份记录。完成首次配对后，任务状态会显示在这里。" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

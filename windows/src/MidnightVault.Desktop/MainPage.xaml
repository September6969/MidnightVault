<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MidnightVault.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="MainPage_Loaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Number1"
            Modifiers="Control"
            Invoked="DashboardAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Number2"
            Modifiers="Control"
            Invoked="LibraryAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Number3"
            Modifiers="Control"
            Invoked="DevicesAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Number4"
            Modifiers="Control"
            Invoked="SettingsAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="Escape"
            Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="ShellNavigationView"
        AlwaysShowHeader="False"
        AutomationProperties.AutomationId="AppShell"
        AutomationProperties.Name="主导航"
        CompactModeThresholdWidth="{StaticResource MidnightCompactBreakpoint}"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="{StaticResource MidnightExpandedBreakpoint}"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="236"
        PaneDisplayMode="Auto"
        SelectionChanged="ShellNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="DashboardNavigationItem"
                Content="概览"
                Tag="dashboard"
                ToolTipService.ToolTip="概览（Ctrl+1）">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="LibraryNavigationItem"
                Content="资料库"
                Tag="library"
                ToolTipService.ToolTip="资料库（Ctrl+2）">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="DevicesNavigationItem"
                Content="设备"
                Tag="devices"
                ToolTipService.ToolTip="设备（Ctrl+3）">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EA;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SettingsNavigationItem"
                Content="设置"
                Tag="settings"
                ToolTipService.ToolTip="设置（Ctrl+4）">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>

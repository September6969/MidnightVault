<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="DevicesRootPage"
    x:Class="MidnightVault.Desktop.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer
            x:Name="DevicesScrollViewer"
            HorizontalContentAlignment="Center"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
            Width="{Binding ActualWidth, ElementName=DevicesScrollViewer}"
            MaxWidth="1000"
            Padding="32,28,32,40"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="设备" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="管理两台 Android 手机的配对、在线状态和最近备份。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <CommandBar
                Grid.Row="1"
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="True">
                <AppBarButton Click="PairDevice_Click" Label="配对新设备">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8FA;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <InfoBar
                x:Name="PairingInfoBar"
                Grid.Row="2"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <StackPanel Grid.Row="3" Spacing="12">
                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            FontSize="28"
                            Glyph="&#xE8EA;" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="设备位置 1" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未配对" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="等待扫码" />
                    </Grid>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            FontSize="28"
                            Glyph="&#xE8EA;" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="设备位置 2" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未配对" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="等待扫码" />
                    </Grid>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

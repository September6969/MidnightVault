<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="DashboardRootPage"
    x:Class="MidnightVault.Desktop.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="DashboardPage_Loaded"
    SizeChanged="DashboardPage_SizeChanged">

    <Grid>
        <ScrollViewer
            x:Name="DashboardScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="DashboardContent"
                Width="{Binding ViewportWidth, ElementName=DashboardScrollViewer}"
                MaxWidth="{StaticResource MidnightPageMaxWidth}"
                Padding="{StaticResource MidnightPagePadding}"
                HorizontalAlignment="Center"
                RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="PageTitle"
                            Style="{StaticResource MidnightPageTitleStyle}"
                            Text="备份概览" />
                        <TextBlock
                            Style="{StaticResource MidnightPageSubtitleStyle}"
                            Text="每天北京时间 00:00 自动收好两台手机的新文件，原文件与历史版本都不会被删除。" />
                    </StackPanel>

                    <Button
                        x:Name="HeaderActionButton"
                        Grid.Column="1"
                        MinWidth="112"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="启动一次手动扫描和上传任务"
                        Click="BackupNow_Click"
                        Content="立即备份"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <InfoBar
                    x:Name="SetupInfoBar"
                    Grid.Row="1"
                    IsClosable="False"
                    IsOpen="True"
                    Message="先选择外接硬盘，再为两台 Android 手机完成配对。完成后即可手动或定时备份。"
                    Severity="Informational"
                    Title="还差两个设置步骤" />

                <Grid
                    x:Name="MetricsGrid"
                    Grid.Row="2"
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MetricColumnOne" Width="1.25*" />
                        <ColumnDefinition x:Name="MetricColumnTwo" Width="*" />
                        <ColumnDefinition x:Name="MetricColumnThree" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="NextRunCard"
                        Padding="22"
                        Style="{StaticResource MidnightAccentCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MidnightIconTileStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Glyph="&#xE823;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="下一次任务" />
                                <TextBlock
                                    x:Name="NextRunText"
                                    Style="{StaticResource MidnightMetricValueStyle}" />
                                <TextBlock
                                    Style="{StaticResource MidnightSecondaryTextStyle}"
                                    Text="错过午夜后会在系统允许时自动补传" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="DeviceCard"
                        Grid.Column="1"
                        Style="{StaticResource MidnightCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MidnightIconTileStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Glyph="&#xE8EA;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="已配对设备" />
                                <TextBlock
                                    x:Name="PairedDeviceCountText"
                                    Style="{StaticResource MidnightMetricValueStyle}"
                                    Text="0 / 2" />
                                <TextBlock
                                    Style="{StaticResource MidnightSecondaryTextStyle}"
                                    Text="两台设备可并行上传" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="DriveCard"
                        Grid.Column="2"
                        Style="{StaticResource MidnightCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MidnightIconTileStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Glyph="&#xEDA2;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="备份盘" />
                                <TextBlock
                                    x:Name="DriveMetricText"
                                    Style="{StaticResource MidnightMetricValueStyle}"
                                    Text="未选择" />
                                <TextBlock
                                    x:Name="DriveMetricDetailText"
                                    Style="{StaticResource MidnightSecondaryTextStyle}"
                                    Text="将按卷唯一 ID 绑定" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MidnightSectionTitleStyle}" Text="最近任务" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="最近 30 天" />
                </Grid>

                <Border
                    Grid.Row="4"
                    MinHeight="220"
                    Style="{StaticResource MidnightEmptyStateStyle}">
                    <Grid
                        x:Name="EmptyStateLayout"
                        ColumnSpacing="28"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EmptyStateImageColumn" Width="Auto" />
                            <ColumnDefinition x:Name="EmptyStateTextColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="EmptyStateImage"
                            Width="150"
                            Height="150"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="等待首次备份的硬盘插画"
                            Source="{StaticResource MidnightAssetEmptyBackup}"
                            Stretch="Uniform" />

                        <StackPanel
                            x:Name="EmptyStateTextPanel"
                            Grid.Column="1"
                            MaxWidth="560"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <TextBlock
                                x:Name="RecentTaskTitleText"
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="首份备份会出现在这里" />
                            <TextBlock
                                x:Name="RecentTaskDescriptionText"
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="每次扫描、上传和 SHA-256 校验都会留下可追溯记录。任务中断后也会从已确认的分块继续。" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource MidnightAccentBrush}"
                                    Glyph="&#xE73E;" />
                                <TextBlock
                                    x:Name="RecentTaskNextText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="下一步：选择备份盘并配对至少一台手机"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

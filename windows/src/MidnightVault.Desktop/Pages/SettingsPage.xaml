<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="SettingsRootPage"
    x:Class="MidnightVault.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="SettingsPage_Loaded"
    SizeChanged="SettingsPage_SizeChanged">

    <Grid AutomationProperties.AutomationId="SettingsPageRoot">
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="SettingsContent"
                Width="{Binding ViewportWidth, ElementName=SettingsScrollViewer}"
                MaxWidth="{StaticResource MidnightPageMaxWidth}"
                Padding="{StaticResource MidnightPagePadding}"
                HorizontalAlignment="Center"
                RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource MidnightPageTitleStyle}"
                        Text="设置" />
                    <TextBlock
                        Style="{StaticResource MidnightPageSubtitleStyle}"
                        Text="确认备份盘、执行时间、网络与保留规则。" />
                </StackPanel>

                <InfoBar
                    x:Name="SettingsInfoBar"
                    Grid.Row="1"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />

                <Border Grid.Row="2" Style="{StaticResource MidnightAccentCardStyle}">
                    <Grid
                        x:Name="DriveSetupLayout"
                        ColumnSpacing="22"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DriveImageColumn" Width="Auto" />
                            <ColumnDefinition x:Name="DriveTextColumn" Width="*" />
                            <ColumnDefinition x:Name="DriveActionColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="DriveSetupImage"
                            Width="126"
                            Height="126"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="受保护的外接硬盘插画"
                            Source="{StaticResource MidnightAssetDriveSetup}"
                            Stretch="Uniform" />

                        <StackPanel
                            x:Name="DriveSetupText"
                            Grid.Column="1"
                            MaxWidth="620"
                            VerticalAlignment="Center"
                            Spacing="7">
                            <TextBlock
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="外接硬盘" />
                            <TextBlock
                                x:Name="DrivePathText"
                                FontWeight="SemiBold"
                                Text="尚未选择备份盘"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DriveStatusText"
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="选择后将按卷唯一 ID 绑定。硬盘断开或空间不足时会暂停，不会回退写入系统盘。" />
                        </StackPanel>

                        <Button
                            x:Name="ChooseDriveButton"
                            Grid.Column="2"
                            MinWidth="104"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="选择连接到电脑的外接硬盘"
                            Click="ChooseDrive_Click"
                            Content="选择硬盘"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource MidnightCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MidnightIconTileStyle}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Glyph="&#xE823;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource MidnightSectionTitleStyle}"
                                    Text="自动备份" />
                                <TextBlock
                                    Style="{StaticResource MidnightSecondaryTextStyle}"
                                    Text="固定使用北京时间，错过后自动补传。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="每日计划" />
                                <TextBlock
                                    Style="{StaticResource MidnightSecondaryTextStyle}"
                                    Text="跨过午夜时继续当前队列，并合并新扫描结果" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource MidnightStatusBadgeStyle}">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Text="00:00" />
                            </Border>
                        </Grid>

                        <ToggleSwitch
                            Header="允许 Wi-Fi 和移动网络上传"
                            IsEnabled="False"
                            IsOn="True"
                            OffContent="停用"
                            OnContent="启用" />
                        <ToggleSwitch
                            Header="断网或重启后自动续传"
                            IsEnabled="False"
                            IsOn="True"
                            OffContent="停用"
                            OnContent="启用" />
                        <TextBlock
                            Style="{StaticResource MidnightSecondaryTextStyle}"
                            Text="网络策略会在接收服务与设备状态接入后开放调整。" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource MidnightCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MidnightIconTileStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                Glyph="&#xE74E;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="存储与保留" />
                            <TextBlock
                                Text="保留原始格式和完整历史，手机删除不会同步删除硬盘文件。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="剩余空间低于 10% 或 50 GB 时暂停并告警，系统永不自动删除旧备份。" />
                            <TextBlock
                                x:Name="CachePathText"
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="预览缓存将在选择硬盘后创建。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource MidnightCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MidnightIconTileStyle}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                Glyph="&#xE950;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="手机服务器控制面" />
                            <TextBlock
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="只同步设备、公钥、任务摘要与远程指令，不中转备份文件。" />
                            <TextBox
                                x:Name="ControlPlaneUrlBox"
                                Header="Cloudflare HTTPS 地址"
                                PlaceholderText="https://control.example.com" />
                            <PasswordBox
                                x:Name="ControlPlaneTokenBox"
                                Header="管理员令牌"
                                PasswordChar="●"
                                PlaceholderText="留空则保留已保存令牌" />
                            <TextBlock
                                x:Name="ControlPlaneStatusText"
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="尚未配置" />
                            <Button
                                x:Name="SaveControlPlaneButton"
                                HorizontalAlignment="Left"
                                Click="SaveControlPlane_Click"
                                Content="保存并测试"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="SettingsRootPage"
    x:Class="MidnightVault.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="SettingsPage_SizeChanged">

    <Grid>
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            HorizontalContentAlignment="Center"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
            Width="{Binding ActualWidth, ElementName=SettingsScrollViewer}"
            MaxWidth="920"
            Padding="32,28,32,40"
            HorizontalAlignment="Stretch"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="设置" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="确认备份盘、时间、网络和保留规则。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="SettingsInfoBar"
                Grid.Row="1"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <Border
                Grid.Row="2"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DriveActionColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="外接硬盘" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未选择备份盘" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正式接入后按卷唯一 ID 绑定；硬盘断开时不会回退写入系统盘。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ChooseDriveButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="选择连接到电脑的外接硬盘"
                        Click="ChooseDrive_Click"
                        Content="选择硬盘" />
                </Grid>
            </Border>

            <Border
                Grid.Row="3"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="自动备份" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="每日计划" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="固定使用北京时间，错过后自动补传" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="00:00" />
                    </Grid>
                    <ToggleSwitch
                        Header="允许 Wi-Fi 和移动网络上传"
                        IsEnabled="False"
                        IsOn="True"
                        OffContent="停用"
                        OnContent="启用" />
                    <ToggleSwitch
                        Header="断网或重启后自动续传"
                        IsEnabled="False"
                        IsOn="True"
                        OffContent="停用"
                        OnContent="启用" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="4"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="存储与保留" />
                    <TextBlock Text="保留原始格式和完整历史，手机删除不会同步删除硬盘文件。" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="剩余空间低于 10% 或 50 GB 时暂停并告警；系统永不自动删除旧备份。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MidnightVault.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="LibraryPage_Loaded"
    SizeChanged="LibraryPage_SizeChanged">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid AutomationProperties.AutomationId="LibraryPageRoot">
        <ScrollViewer
            x:Name="LibraryScrollViewer"
            AutomationProperties.AutomationId="LibraryScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="LibraryContent"
                Width="{Binding ViewportWidth, ElementName=LibraryScrollViewer}"
                MaxWidth="{StaticResource MidnightPageMaxWidth}"
                Padding="{StaticResource MidnightPagePadding}"
                HorizontalAlignment="Center"
                RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource MidnightPageTitleStyle}"
                        Text="资料库" />
                    <TextBlock
                        Style="{StaticResource MidnightPageSubtitleStyle}"
                        Text="按设备、日期和类型浏览外接硬盘中的备份文件，原始路径与版本信息会一并保留。" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="FilterThirdColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        AutomationProperties.AutomationId="LibrarySearchBox"
                        AutomationProperties.Name="搜索资料库"
                        IsEnabled="False"
                        PlaceholderText="搜索文件名或原始路径"
                        TextChanged="SearchBox_TextChanged" />
                    <ComboBox
                        x:Name="TypeFilter"
                        Grid.Column="1"
                        MinWidth="140"
                        AutomationProperties.Name="文件类型筛选"
                        IsEnabled="False"
                        SelectionChanged="TypeFilter_SelectionChanged"
                        SelectedIndex="0">
                        <ComboBoxItem Content="全部类型" />
                        <ComboBoxItem Content="照片" />
                        <ComboBoxItem Content="视频" />
                        <ComboBoxItem Content="下载" />
                        <ComboBoxItem Content="文档" />
                    </ComboBox>
                    <CommandBar
                        x:Name="LibraryCommandBar"
                        Grid.Column="2"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed">
                        <AppBarButton
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            IsEnabled="False"
                            Label="刷新">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="12">
                    <InfoBar
                        x:Name="LibraryInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="True"
                        IsOpen="False" />

                    <ProgressRing
                        x:Name="LibraryLoadingIndicator"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="正在更新资料库"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <Grid>
                        <Border
                            x:Name="LibraryEmptyState"
                            MinHeight="360"
                            Style="{StaticResource MidnightEmptyStateStyle}">
                            <Grid
                                x:Name="EmptyStateLayout"
                                ColumnSpacing="34"
                                RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EmptyImageColumn" Width="Auto" />
                            <ColumnDefinition x:Name="EmptyTextColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="EmptyLibraryImage"
                            Width="176"
                            Height="176"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="等待文件进入保险库的插画"
                            Source="{StaticResource MidnightAssetEmptyLibrary}"
                            Stretch="Uniform" />

                        <StackPanel
                            x:Name="EmptyTextPanel"
                            Grid.Column="1"
                            MaxWidth="560"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <TextBlock
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="资料库正在等待首批文件" />
                            <TextBlock
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="文件完成上传与 SHA-256 校验后会出现在这里。照片、视频、PDF 和文本可直接预览，Office 文件会调用系统默认程序。" />
                            <Border
                                HorizontalAlignment="Left"
                                Style="{StaticResource MidnightStatusBadgeStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Text="完成首次备份后自动启用搜索与筛选" />
                            </Border>
                        </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel
                            x:Name="LibraryResults"
                            Spacing="16"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="ResultCountText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MidnightSecondaryTextStyle}" />
                                <ComboBox
                                    x:Name="FolderFilter"
                                    Grid.Column="1"
                                    MinWidth="190"
                                    AutomationProperties.Name="文件夹分区筛选"
                                    DisplayMemberPath="Label"
                                    IsEnabled="False"
                                    SelectionChanged="FolderFilter_SelectionChanged" />
                            </Grid>

                            <Grid
                                x:Name="ResultsBodyGrid"
                                ColumnSpacing="0"
                                RowSpacing="18"
                                SizeChanged="StickyLayout_SizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="340" />
                                </Grid.ColumnDefinitions>

                                <ItemsRepeater x:Name="LibraryFolderRepeater">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,24" Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="20"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Style="{StaticResource MidnightSecondaryTextStyle}"
                                                        Text="{Binding Breadcrumb}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ItemsRepeater ItemsSource="{Binding Items}">
                                                    <ItemsRepeater.Layout>
                                                        <UniformGridLayout
                                                            MinItemWidth="224"
                                                            MinItemHeight="246"
                                                            ItemsJustification="Start"
                                                            ItemsStretch="Fill" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Margin="0,0,10,10"
                                                                Padding="0"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                AutomationProperties.Name="{Binding FileName}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="LibraryCard_Click"
                                                                Tag="{Binding}">
                                                                <Border
                                                                    Height="236"
                                                                    DoubleTapped="LibraryItem_DoubleTapped"
                                                                    Tag="{Binding}"
                                                                    Style="{StaticResource MidnightCardStyle}">
                                                                    <Border.ContextFlyout>
                                                                        <MenuFlyout>
                                                                            <MenuFlyoutItem
                                                                                Click="PreviewFile_Click"
                                                                                Tag="{Binding Item}"
                                                                                Text="预览" />
                                                                            <MenuFlyoutItem
                                                                                Click="OpenInExplorer_Click"
                                                                                Tag="{Binding Item}"
                                                                                Text="在资源管理器中显示" />
                                                                            <MenuFlyoutSeparator />
                                                                            <MenuFlyoutItem
                                                                                Click="CopyOriginalPath_Click"
                                                                                Tag="{Binding Item}"
                                                                                Text="复制原始路径" />
                                                                        </MenuFlyout>
                                                                    </Border.ContextFlyout>
                                                                    <Grid RowSpacing="10">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="136" />
                                                                            <RowDefinition Height="*" />
                                                                        </Grid.RowDefinitions>
                                                                        <Border
                                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                            CornerRadius="8">
                                                                            <Grid>
                                                                                <FontIcon
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    FontSize="34"
                                                                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                                                                    Glyph="&#xE8A5;" />
                                                                                <Image
                                                                                    AutomationProperties.Name="{Binding FileName}"
                                                                                    Source="{Binding ThumbnailSource}"
                                                                                    Stretch="UniformToFill" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Row="1" Spacing="3">
                                                                            <TextBlock
                                                                                FontSize="16"
                                                                                FontWeight="SemiBold"
                                                                                Text="{Binding FileName}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock
                                                                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                                                                Text="{Binding Detail}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <Border
                                    x:Name="SelectedPreviewPanel"
                                    AutomationProperties.AutomationId="SelectedPreviewPanel"
                                    Grid.Column="1"
                                    Canvas.ZIndex="1"
                                    MinHeight="300"
                                    SizeChanged="StickyLayout_SizeChanged"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource MidnightCardStyle}">
                                    <Grid>
                                        <TextBlock
                                            x:Name="PreviewHintText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="选择文件查看预览"
                                            Style="{StaticResource MidnightSecondaryTextStyle}" />
                                        <StackPanel
                                            x:Name="SelectedPreviewContent"
                                            Spacing="12"
                                            Visibility="Collapsed">
                                            <Border
                                                x:Name="SelectedPreviewMedia"
                                                Height="260"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid>
                                                    <FontIcon
                                                        x:Name="SelectedPreviewFallback"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="48"
                                                        Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                                        Glyph="&#xE8A5;" />
                                                    <Image
                                                        x:Name="SelectedPreviewImage"
                                                        AutomationProperties.Name="所选图片预览"
                                                        Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                x:Name="SelectedFileName"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                x:Name="SelectedFilePath"
                                                MaxLines="3"
                                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                x:Name="SelectedFileDetail"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    x:Name="OpenSelectedPreviewButton"
                                                    Click="OpenSelectedPreview_Click"
                                                    Content="打开大图" />
                                                <Button
                                                    Click="OpenInExplorer_Click"
                                                    Content="定位文件"
                                                    Tag="{Binding Item}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MidnightVault.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="LibraryPage_Loaded"
    SizeChanged="LibraryPage_SizeChanged">

    <Grid>
        <ScrollViewer
            x:Name="LibraryScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="LibraryContent"
                Width="{Binding ViewportWidth, ElementName=LibraryScrollViewer}"
                MaxWidth="{StaticResource MidnightPageMaxWidth}"
                Padding="{StaticResource MidnightPagePadding}"
                HorizontalAlignment="Center"
                RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitle"
                        Style="{StaticResource MidnightPageTitleStyle}"
                        Text="资料库" />
                    <TextBlock
                        Style="{StaticResource MidnightPageSubtitleStyle}"
                        Text="按设备、日期和类型浏览外接硬盘中的备份文件，原始路径与版本信息会一并保留。" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="FilterThirdColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        AutomationProperties.Name="搜索资料库"
                        IsEnabled="False"
                        PlaceholderText="搜索文件名或原始路径"
                        TextChanged="SearchBox_TextChanged" />
                    <ComboBox
                        x:Name="TypeFilter"
                        Grid.Column="1"
                        MinWidth="140"
                        AutomationProperties.Name="文件类型筛选"
                        IsEnabled="False"
                        SelectionChanged="TypeFilter_SelectionChanged"
                        SelectedIndex="0">
                        <ComboBoxItem Content="全部类型" />
                        <ComboBoxItem Content="照片" />
                        <ComboBoxItem Content="视频" />
                        <ComboBoxItem Content="下载" />
                        <ComboBoxItem Content="文档" />
                    </ComboBox>
                    <CommandBar
                        x:Name="LibraryCommandBar"
                        Grid.Column="2"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed">
                        <AppBarButton
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            IsEnabled="False"
                            Label="刷新">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="12">
                    <InfoBar
                        x:Name="LibraryInfoBar"
                        IsClosable="True"
                        IsOpen="False" />

                    <Grid>
                        <Border
                            x:Name="LibraryEmptyState"
                            MinHeight="360"
                            Style="{StaticResource MidnightEmptyStateStyle}">
                            <Grid
                                x:Name="EmptyStateLayout"
                                ColumnSpacing="34"
                                RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EmptyImageColumn" Width="Auto" />
                            <ColumnDefinition x:Name="EmptyTextColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="EmptyLibraryImage"
                            Width="176"
                            Height="176"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="等待文件进入保险库的插画"
                            Source="{StaticResource MidnightAssetEmptyLibrary}"
                            Stretch="Uniform" />

                        <StackPanel
                            x:Name="EmptyTextPanel"
                            Grid.Column="1"
                            MaxWidth="560"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <TextBlock
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="资料库正在等待首批文件" />
                            <TextBlock
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="文件完成上传与 SHA-256 校验后会出现在这里。照片、视频、PDF 和文本可直接预览，Office 文件会调用系统默认程序。" />
                            <Border
                                HorizontalAlignment="Left"
                                Style="{StaticResource MidnightStatusBadgeStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Text="完成首次备份后自动启用搜索与筛选" />
                            </Border>
                        </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel
                            x:Name="LibraryResults"
                            Spacing="12"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ResultCountText"
                                Style="{StaticResource MidnightSecondaryTextStyle}" />
                            <ItemsControl x:Name="LibraryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,10"
                                            Style="{StaticResource MidnightCardStyle}">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource MidnightIconTileStyle}">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="20"
                                                        Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                                        Glyph="&#xE8A5;" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding FileName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource MidnightSecondaryTextStyle}"
                                                        Text="{Binding RelativePath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detail}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="预览文件"
                                                    Click="PreviewFile_Click"
                                                    Content="预览"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MidnightVault.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="LibraryPage_SizeChanged">

    <Grid MaxWidth="1000" Padding="32,28,32,40" HorizontalAlignment="Stretch" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="资料库" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="按设备、日期和类型浏览外接硬盘中的备份文件。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="FilterThirdColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="搜索资料库"
                IsEnabled="False"
                PlaceholderText="完成首次备份后可搜索文件名或目录" />
            <ComboBox
                x:Name="TypeFilter"
                Grid.Column="1"
                MinWidth="130"
                AutomationProperties.Name="文件类型筛选"
                IsEnabled="False"
                SelectedIndex="0">
                <ComboBoxItem Content="全部类型" />
                <ComboBoxItem Content="照片" />
                <ComboBoxItem Content="视频" />
                <ComboBoxItem Content="下载" />
                <ComboBoxItem Content="文档" />
            </ComboBox>
            <CommandBar
                x:Name="LibraryCommandBar"
                Grid.Column="2"
                Background="Transparent"
                DefaultLabelPosition="Collapsed">
                <AppBarButton IsEnabled="False" Label="刷新">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Border
            Grid.Row="2"
            MinHeight="320"
            Padding="32"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8B9;" />
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="资料库还是空的" />
                <TextBlock
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="文件完成上传和 SHA-256 校验后会出现在这里。照片、视频、PDF 和文本预览将在资料库里打开。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MidnightVault.Desktop.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="LibraryPage_Loaded"
    SizeChanged="LibraryPage_SizeChanged">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid AutomationProperties.AutomationId="LibraryPageRoot">
        <ScrollViewer
            x:Name="LibraryScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="LibraryContent"
                Width="{Binding ViewportWidth, ElementName=LibraryScrollViewer}"
                MaxWidth="{StaticResource MidnightPageMaxWidth}"
                Padding="{StaticResource MidnightPagePadding}"
                HorizontalAlignment="Center"
                RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource MidnightPageTitleStyle}"
                        Text="资料库" />
                    <TextBlock
                        Style="{StaticResource MidnightPageSubtitleStyle}"
                        Text="按设备、日期和类型浏览外接硬盘中的备份文件，原始路径与版本信息会一并保留。" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="FilterThirdColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        AutomationProperties.AutomationId="LibrarySearchBox"
                        AutomationProperties.Name="搜索资料库"
                        IsEnabled="False"
                        PlaceholderText="搜索文件名或原始路径"
                        TextChanged="SearchBox_TextChanged" />
                    <ComboBox
                        x:Name="TypeFilter"
                        Grid.Column="1"
                        MinWidth="140"
                        AutomationProperties.Name="文件类型筛选"
                        IsEnabled="False"
                        SelectionChanged="TypeFilter_SelectionChanged"
                        SelectedIndex="0">
                        <ComboBoxItem Content="全部类型" />
                        <ComboBoxItem Content="照片" />
                        <ComboBoxItem Content="视频" />
                        <ComboBoxItem Content="下载" />
                        <ComboBoxItem Content="文档" />
                    </ComboBox>
                    <CommandBar
                        x:Name="LibraryCommandBar"
                        Grid.Column="2"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed">
                        <AppBarButton
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            IsEnabled="False"
                            Label="刷新">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="12">
                    <InfoBar
                        x:Name="LibraryInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="True"
                        IsOpen="False" />

                    <ProgressRing
                        x:Name="LibraryLoadingIndicator"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="正在更新资料库"
                        IsActive="False"
                        Visibility="Collapsed" />

                    <Grid>
                        <Border
                            x:Name="LibraryEmptyState"
                            MinHeight="360"
                            Style="{StaticResource MidnightEmptyStateStyle}">
                            <Grid
                                x:Name="EmptyStateLayout"
                                ColumnSpacing="34"
                                RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EmptyImageColumn" Width="Auto" />
                            <ColumnDefinition x:Name="EmptyTextColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="EmptyLibraryImage"
                            Width="176"
                            Height="176"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="等待文件进入保险库的插画"
                            Source="{StaticResource MidnightAssetEmptyLibrary}"
                            Stretch="Uniform" />

                        <StackPanel
                            x:Name="EmptyTextPanel"
                            Grid.Column="1"
                            MaxWidth="560"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <TextBlock
                                Style="{StaticResource MidnightSectionTitleStyle}"
                                Text="资料库正在等待首批文件" />
                            <TextBlock
                                Style="{StaticResource MidnightSecondaryTextStyle}"
                                Text="文件完成上传与 SHA-256 校验后会出现在这里。照片、视频、PDF 和文本可直接预览，Office 文件会调用系统默认程序。" />
                            <Border
                                HorizontalAlignment="Left"
                                Style="{StaticResource MidnightStatusBadgeStyle}">
                                <TextBlock
                                    Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                    Text="完成首次备份后自动启用搜索与筛选" />
                            </Border>
                        </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel
                            x:Name="LibraryResults"
                            Spacing="12"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ResultCountText"
                                Style="{StaticResource MidnightSecondaryTextStyle}" />
                            <ItemsRepeater x:Name="LibraryItemsRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,10"
                                            DoubleTapped="LibraryItem_DoubleTapped"
                                            Tag="{Binding}"
                                            Style="{StaticResource MidnightCardStyle}">
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="PreviewFile_Click"
                                                        Tag="{Binding}"
                                                        Text="预览">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE890;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        Click="OpenInExplorer_Click"
                                                        Tag="{Binding}"
                                                        Text="在资源管理器中显示">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Click="CopyOriginalPath_Click"
                                                        Tag="{Binding}"
                                                        Text="复制原始路径">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource MidnightIconTileStyle}">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="20"
                                                        Foreground="{ThemeResource MidnightAccentStrongBrush}"
                                                        Glyph="&#xE8A5;" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding FileName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource MidnightSecondaryTextStyle}"
                                                        Text="{Binding RelativePath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detail}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Button
                                                        AutomationProperties.Name="预览文件"
                                                        Click="PreviewFile_Click"
                                                        Content="预览"
                                                        Tag="{Binding}"
                                                        ToolTipService.ToolTip="双击或按此按钮预览文件" />
                                                    <DropDownButton
                                                        AutomationProperties.Name="更多文件操作"
                                                        Content="更多">
                                                        <DropDownButton.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem
                                                                    Click="OpenInExplorer_Click"
                                                                    Tag="{Binding}"
                                                                    Text="在资源管理器中显示" />
                                                                <MenuFlyoutItem
                                                                    Click="CopyOriginalPath_Click"
                                                                    Tag="{Binding}"
                                                                    Text="复制原始路径" />
                                                            </MenuFlyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MidnightPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource MidnightPageTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MidnightPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MidnightBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MidnightSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource MidnightSectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MidnightMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource MidnightMetricFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MidnightSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MidnightBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MidnightCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MidnightCardCornerRadius}" />
    </Style>

    <Style
        x:Key="MidnightAccentCardStyle"
        BasedOn="{StaticResource MidnightCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MidnightHeroBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MidnightHeroStrokeBrush}" />
    </Style>

    <Style x:Key="MidnightEmptyStateStyle" TargetType="Border">
        <Setter Property="Padding" Value="28" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MidnightCardCornerRadius}" />
    </Style>

    <Style x:Key="MidnightIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{ThemeResource MidnightAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="MidnightStatusBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{ThemeResource MidnightAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</ResourceDictionary>
